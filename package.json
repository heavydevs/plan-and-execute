{
  "name": "@luizcgvrj/plan-and-execute",
  "version": "0.7.0",
  "description": "Install plan-and-execute for evidence-backed planning, context-isolated TODOs, resumable subtasks, selective validated learning, and fresh Claude Code, Codex, Gemini, Qwen, Kimi, or Trae workers.",
  "type": "module",
  "bin": {
    "plan-and-execute": "bin/plan-and-execute.js",
    "pae": "bin/plan-and-execute.js"
  },
  "files": [
    "bin/",
    "lib/",
    "skill/",
    "docs/",
    "README.md",
    "README.pt-BR.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node tools/clean-generated.js",
    "validate:skill": "node tools/validate-skill.js",
    "test:node": "node --test test/*.test.js",
    "test:skill": "node tools/run-skill-self-test.js",
    "test": "npm run test:node && npm run test:skill",
    "check": "npm run clean && npm run validate:skill && npm test",
    "prepack": "npm run check"
  },
  "engines": {
    "node": ">=18.17"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heavydevs/plan-and-execute.git"
  },
  "homepage": "https://github.com/heavydevs/plan-and-execute#readme",
  "bugs": {
    "url": "https://github.com/heavydevs/plan-and-execute/issues"
  },
  "keywords": [
    "agent-skill",
    "claude-code",
    "codex",
    "gemini-cli",
    "qwen-code",
    "kimi-code",
    "trae-agent",
    "orchestration",
    "planning",
    "research",
    "resume",
    "lifecycle",
    "context-engineering",
    "context-isolation",
    "progressive-context"
  ],
  "author": "Luiz Valenca",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
