+HYPOTHESIS_SIMILARITY_STOPWORDS = frozenset({
+    "a", "an", "and", "are", "as", "at", "be", "been", "before", "by", "did", "do",
+    "does", "for", "from", "had", "has", "have", "in", "into", "is", "it", "its",
