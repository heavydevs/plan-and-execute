  "current_requirements": [
    {
      "id": "R001",
      "text": "Implement the prepared research recommendations in this one plan; do not create another plan.",
      "source": "user",
      "priority": "must",
      "request_part_ids": [
        "P001"
      ]
    },
    {
      "id": "R002",
      "text": "Use the pinned source inventory and per-feature reports to implement traceable skill improvements.",
      "source": "user",
      "priority": "must",
      "request_part_ids": [
        "P002"
      ]
    },
    {
      "id": "R003",
      "text": "Replace every research task and its internal checklist with implementation instructions linked to its prepared report.",
      "source": "user",
      "priority": "must",
      "request_part_ids": [
        "P003"
      ]
    },
    {
      "id": "R004",
      "text": "Require independent maximum-available-capability code review after each implementation topic; do not fabricate reviewer execution.",
      "source": "user",
      "priority": "must",
      "request_part_ids": [
        "P004"
      ]
    },
    {
      "id": "R005",
      "text": "Compare quality per validated cost, alternatives, risks and measurable regression criteria.",
      "source": "user",
      "priority": "must",
      "request_part_ids": [
        "P005"
      ]
    },
    {
      "id": "R006",
      "text": "Implement the opt-in provider-top switching improvement within this single plan.",
      "source": "user",
      "priority": "must",
      "request_part_ids": [
        "P006"
      ]
    },
    {
      "id": "R007",
      "text": "Reconfirm decisive source claims; distinguish verified facts, hypotheses and new inference.",
      "source": "user",
      "priority": "must",
      "request_part_ids": [
        "P007"
      ]
    },
    {
      "id": "R008",
      "text": "Modify only the source checkout; preserve installed skills and user-global configuration.",
      "source": "user",
      "priority": "must",
      "request_part_ids": [
        "P008"
      ]
    },
    {
      "id": "R009",
      "text": "Pin the actual source baseline, affected tests and historical evidence; do not represent old logs as fresh validation.",
      "source": "user",
      "priority": "must",
      "request_part_ids": [
        "P009"
      ]
    },
    {
      "id": "R010",
      "text": "Continue in the existing checkpoint workstream without modifying main or publishing without permission.",
      "source": "user",
      "priority": "must",
      "request_part_ids": [
        "P010"
      ]
    },
    {
      "id": "R011",
      "text": "Require confirmation before commit, push, PR, npm publication and authenticated provider execution.",
      "source": "user",
      "priority": "must",
      "request_part_ids": [
        "P011"
      ]
    },
    {
      "id": "R012",
      "text": "Keep the new provider-switch behavior opt-in; disabled behavior and argv goldens stay unchanged.",
      "source": "user",
      "priority": "must",
      "request_part_ids": [
        "P012"
      ]
    },
    {
      "id": "R013",
      "text": "Use one explicit provider-chain policy so the ladder matches the actual dispatched provider.",
      "source": "user",
      "priority": "must",
      "request_part_ids": [
        "P013"
      ]
    },
    {
      "id": "R014",
      "text": "Derive useful top from resolved model and effective effort, including embedded slugs and snapshot/profile rules.",
      "source": "user",
      "priority": "must",
      "request_part_ids": [
        "P014"
      ]
    },
    {
      "id": "R015",
      "text": "Make every eligible provider reachable within documented attempt budgeting; test third-provider access at budget eight.",
      "source": "user",
      "priority": "must",
      "request_part_ids": [
        "P015"
      ]
    },
    {
      "id": "R016",
      "text": "Define mechanical/budget retry exceptions; environmental, plan_defect and timeout_ceiling never trigger capability switching.",
      "source": "user",
      "priority": "must",
      "request_part_ids": [
        "P016"
      ]
    },
    {
      "id": "R017",
      "text": "Use the prepared comparison to implement deterministic handoff first; keep additional paid summary calls and native retention out of the default.",
      "source": "user",
      "priority": "must",
      "request_part_ids": [
        "P017"
      ]
    },
    {
      "id": "R018",
      "text": "Redact secrets before truncation and bound the handoff; never capture environment or profile values.",
      "source": "user",
      "priority": "must",
      "request_part_ids": [
        "P018"
      ]
    },
    {
      "id": "R019",
      "text": "Label handoff as unverified data after deterministic evidence; it cannot change route, class or status.",
      "source": "user",
      "priority": "must",
      "request_part_ids": [
        "P019"
      ]
    },
    {
      "id": "R020",
      "text": "Validate handoff paths against diff, commands against evidence and subtask IDs against the manifest.",
      "source": "user",
      "priority": "must",
      "request_part_ids": [
        "P020"
      ]
    },
    {
      "id": "R021",
      "text": "Produce deterministic handoff when the previous provider is unavailable or its report is missing or invalid.",
      "source": "user",
      "priority": "must",
      "request_part_ids": [
        "P021"
      ]
    },
    {
      "id": "R022",
      "text": "Keep byte-stable prompt prefixes, add only the newest attempt-bound capsule and retain failure_context.",
      "source": "user",
      "priority": "must",
      "request_part_ids": [
        "P022"
      ]
    },
    {
      "id": "R023",
      "text": "Preserve strict report-schema compatibility, including Codex required-nullable fields and Antigravity null adaptation.",
      "source": "user",
      "priority": "must",
      "request_part_ids": [
        "P023"
      ]
    },
    {
      "id": "R024",
      "text": "Preserve manifest schemas 1-4, missing failure_classes, version-1 configuration snapshots and availability ledger compatibility.",
      "source": "user",
      "priority": "must",
      "request_part_ids": [
        "P024"
      ]
    },
    {
      "id": "R025",
      "text": "Keep availability separate from functional evidence; preserve provider, quota_pool and model cooldowns and exit 75.",
