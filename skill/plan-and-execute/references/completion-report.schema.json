{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          },
          "details": {
            "type": "string"
          }
        },
        "required": [
          "command",
          "passed",
          "details"
        ],
        "additionalProperties": false
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "follow_ups": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "context_files_read": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_task_reads": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "task_id",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "blocked_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "learning_files_read": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "completed_subtask_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "reusable_learnings": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "code",
              "procedure",
              "decision",
              "pitfall",
              "validation"
            ]
          },
          "guidance": {
            "type": "string",
            "minLength": 35,
            "maxLength": 420
          },
          "references": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "string"
            }
          },
          "target_task_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "kind",
          "guidance",
          "references",
          "target_task_ids"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "status",
    "summary",
    "changed_files",
    "validations",
    "risks",
    "follow_ups",
    "context_files_read",
    "learning_files_read",
    "completed_subtask_ids",
    "reusable_learnings",
    "related_task_reads",
    "blocked_reason"
  ],
  "additionalProperties": false
}
