{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["completed", "blocked"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 360
    },
    "changed_files": {
      "type": "array",
      "maxItems": 100,
      "items": {"type": "string", "maxLength": 300}
    },
    "validations": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "properties": {
          "command": {"type": "string", "maxLength": 1000},
          "passed": {"type": "boolean"},
          "details": {"type": "string", "maxLength": 600}
        },
        "required": ["command", "passed", "details"],
        "additionalProperties": false
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 8,
      "items": {"type": "string", "maxLength": 240}
    },
    "follow_ups": {
      "type": "array",
      "maxItems": 8,
      "items": {"type": "string", "maxLength": 240}
    },
    "context_files_read": {
      "type": "array",
      "maxItems": 16,
      "items": {"type": "string", "maxLength": 300},
      "uniqueItems": true
    },
    "related_task_reads": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "task_id": {"type": "string", "maxLength": 32},
          "reason": {"type": "string", "maxLength": 240}
        },
        "required": ["task_id", "reason"],
        "additionalProperties": false
      }
    },
    "blocked_reason": {
      "type": ["string", "null"],
      "maxLength": 800
    },
    "learning_files_read": {
      "type": "array",
      "maxItems": 16,
      "items": {"type": "string", "maxLength": 300},
      "uniqueItems": true
    },
    "completed_subtask_ids": {
      "type": "array",
      "maxItems": 24,
      "items": {"type": "string", "maxLength": 32},
      "uniqueItems": true
    },
    "reusable_learnings": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["code", "procedure", "decision", "pitfall", "validation"]
          },
          "guidance": {
            "type": "string",
            "minLength": 35,
            "maxLength": 320
          },
          "references": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {"type": "string", "maxLength": 240},
            "uniqueItems": true
          },
          "target_task_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {"type": "string", "maxLength": 32},
            "uniqueItems": true
          }
        },
        "required": ["kind", "guidance", "references", "target_task_ids"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "status",
    "summary",
    "changed_files",
    "validations",
    "risks",
    "follow_ups",
    "context_files_read",
    "learning_files_read",
    "completed_subtask_ids",
    "reusable_learnings",
    "related_task_reads",
    "blocked_reason"
  ],
  "additionalProperties": false
}
